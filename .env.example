# Copy this file to .env and fill in your own values.
# deploy_hpb_local.sh and imports_fixed.sh both load .env automatically if
# it exists. .env itself is gitignored -- never commit real credentials.

# MySQL password for the local db_hpb database (deploy_hpb_local.sh)
MYSQL_PASSWORD=

# Your own fork that deploy_hpb_local.sh pushes merged builds to
# (deploy_hpb_local.sh) -- e.g. https://github.com/<you>/HPB-AI.git
YOUR_REPO=

# HPB-AI admin login used to import the lookup-list templates
# (imports_fixed.sh) -- must be an existing admin account on the app
# instance you're importing into.
HPB_ADMIN_USERNAME=
HPB_ADMIN_PASSWORD=
